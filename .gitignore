# Python runtime download cache (prepare_python_runtime.py)
.cache/

# Python runtimes are prepared locally during packaging; keep generated runtime
# files out of git while preserving the documented staging layout.
python-runtime/win-x64/**
!python-runtime/win-x64/
!python-runtime/win-x64/README.md
!python-runtime/win-x64/.gitkeep
python-runtime/mac-arm64/**
!python-runtime/mac-arm64/
!python-runtime/mac-arm64/README.md
!python-runtime/mac-arm64/bin/
!python-runtime/mac-arm64/bin/.gitkeep

# Excel temp files
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx

# App data
~/.officewhere/

# Private agent/user instruction files
CLAUDE.md
AGENTS.md

# Internal docs (not for end users)
ARCHITECTURE.md
PLAN.md

# Generated smoke-test inputs (regenerate via scripts/generate_demo_cases.py)
examples/demo_cases/

# Onboarding example library is intentionally tracked and packaged with Electron.

# Codex local marker
.codex

.omx/
.pytest_cache/
