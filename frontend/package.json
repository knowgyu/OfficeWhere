{
  "name": "officewhere",
  "productName": "OfficeWhere",
  "version": "0.10.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build && npm run build:electron && electron .",
    "package:win": "electron-builder --win zip --publish never",
    "prepare:python-runtime:mac": "python3 ../scripts/prepare_python_runtime.py mac-arm64",
    "package:mac": "npm run prepare:python-runtime:mac && electron-builder --mac --publish never",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.0.0",
    "msw": "^2.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.0",
    "vite": "^5.1.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.officewhere.app",
    "productName": "OfficeWhere",
    "publish": null,
    "icon": "public/officewhere-icon.ico",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "renderer"
      },
      {
        "from": "../backend",
        "to": "backend-source/backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../backend_server.py",
        "to": "backend-source/backend_server.py"
      }
    ],
    "win": {
      "icon": "public/officewhere-icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "officewhere-${version}-windows-x64.${ext}",
      "extraResources": [
        {
          "from": "../python-runtime/win-x64",
          "to": "python-runtime"
        }
      ]
    },
    "mac": {
      "icon": "public/officewhere-icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "officewhere-${version}-mac-${arch}.${ext}",
      "identity": null,
      "extraResources": [
        {
          "from": "../python-runtime/mac-arm64",
          "to": "python-runtime"
        }
      ]
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  },
  "license": "GPL-3.0-only"
}
