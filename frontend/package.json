{
  "name": "officewhere",
  "productName": "OfficeWhere",
  "version": "0.1.3",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build && npm run build:electron && electron .",
    "package:win": "electron-builder --win zip",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.0",
    "vite": "^5.1.0"
  },
  "build": {
    "appId": "com.officewhere.app",
    "productName": "OfficeWhere",
    "icon": "public/officewhere-icon.ico",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "renderer"
      },
      {
        "from": "../dist/officewhere-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "public/officewhere-icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "officewhere-${version}-windows-x64.${ext}"
    }
  }
}
